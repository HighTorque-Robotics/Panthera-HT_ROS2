<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="panthera_ht_ros_description">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import panthera_ht_ros_description urdf file -->
    <xacro:include filename="$(find panthera_ht_description)/urdf/panthera_ht_ros_description_gripper.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="panthera_ht_ros_description.ros2_control.xacro" />


    <xacro:panthera_ht_ros_description_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>

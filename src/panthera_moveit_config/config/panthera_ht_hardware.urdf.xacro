<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="panthera_ht_ros_description">
    <xacro:arg name="config_file" default="$(find hightorque_robot)/robot_param/Leader.yaml" />
    <xacro:arg name="control_mode" default="position_velocity" />

    <!-- Import panthera_ht_ros_description urdf file -->
    <xacro:include filename="$(find panthera_ht_description)/urdf/panthera_ht_ros_description_gripper.urdf.xacro" />

    <!-- Import hardware control_xacro -->
    <xacro:include filename="panthera_ht_hardware.ros2_control.xacro" />

    <!-- Instantiate hardware interface -->
    <xacro:panthera_ht_ros_description_hardware_ros2_control
        name="PantheraHardware"
        config_file="$(arg config_file)"
        control_mode="$(arg control_mode)"/>

</robot>

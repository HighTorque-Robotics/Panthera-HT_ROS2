<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="panthera_ht_ros_description">

  <!-- ==================== 属性定义 ==================== -->
  <!-- 材质颜色 -->
  <xacro:property name="robot_color" value="0.752941176470588 0.752941176470588 0.752941176470588 1"/>

  <!-- ==================== 宏定义 ==================== -->

  <!-- 材质宏 -->
  <xacro:macro name="default_material">
    <material name="">
      <color rgba="${robot_color}"/>
    </material>
  </xacro:macro>

  <!-- 通用 link 宏（带 mesh） -->
  <xacro:macro name="arm_link" params="name mass ixx ixy ixz iyy iyz izz origin_xyz origin_rpy mesh_file">
    <link name="${name}">
      <inertial>
        <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
        <mass value="${mass}"/>
        <inertia ixx="${ixx}" ixy="${ixy}" ixz="${ixz}"
                 iyy="${iyy}" iyz="${iyz}" izz="${izz}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://panthera_ht_ros_description/meshes/${mesh_file}"/>
        </geometry>
        <xacro:default_material/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://panthera_ht_ros_description/meshes/${mesh_file}"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <!-- 旋转关节宏 -->
  <xacro:macro name="revolute_joint" params="name parent child origin_xyz origin_rpy axis_xyz lower upper effort velocity">
    <joint name="${name}" type="revolute">
      <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
      <parent link="${parent}"/>
      <child link="${child}"/>
      <axis xyz="${axis_xyz}"/>
      <limit lower="${lower}" upper="${upper}" effort="${effort}" velocity="${velocity}"/>
    </joint>
  </xacro:macro>

  <!-- ==================== 机器人结构定义 ==================== -->

  <!-- Base Link -->
  <xacro:arm_link
    name="base_link"
    mass="0.62922454"
    ixx="0.00061305" ixy="-1.32e-06" ixz="1.69e-06"
    iyy="0.00063876" iyz="-2.1e-07" izz="0.0007565"
    origin_xyz="5.789e-05 -0.00015938 0.02298649"
    origin_rpy="0 0 0"
    mesh_file="base_link.STL"/>

  <!-- Link 1 -->
  <xacro:arm_link
    name="link1"
    mass="0.28101551"
    ixx="0.00039386" ixy="3.75e-06" ixz="-3.733e-05"
    iyy="0.0002136" iyz="7.17e-06" izz="0.00037066"
    origin_xyz="0.00278873 -0.00094387 0.02491842"
    origin_rpy="0 0 0"
    mesh_file="link1.STL"/>

  <!-- Joint 1 -->
  <xacro:revolute_joint
    name="joint1"
    parent="base_link" child="link1"
    origin_xyz="0 0 0.0584" origin_rpy="0 0 0"
    axis_xyz="0 0 1"
    lower="-2.4" upper="2.4"
    effort="21" velocity="4.2"/>

  <!-- Link 2 -->
  <xacro:arm_link
    name="link2"
    mass="1.5165092"
    ixx="0.00044711" ixy="3.071e-05" ixz="-5.119e-05"
    iyy="0.02261049" iyz="3.01e-06" izz="0.02272105"
    origin_xyz="-0.12936212 -0.00213339 7.183e-05"
    origin_rpy="0 0 0"
    mesh_file="link2.STL"/>

  <!-- Joint 2 -->
  <xacro:revolute_joint
    name="joint2"
    parent="link1" child="link2"
    origin_xyz="0.018199 0 0.053" origin_rpy="0 0 0"
    axis_xyz="0 1 0"
    lower="0.0" upper="3.2"
    effort="36" velocity="5"/>

  <!-- Link 3 -->
  <xacro:arm_link
    name="link3"
    mass="0.66917784"
    ixx="0.00061339" ixy="-1.439e-05" ixz="-0.00070321"
    iyy="0.00538615" iyz="-1.404e-05" izz="0.00532976"
    origin_xyz="0.16343103 -0.00164646 0.05337427"
    origin_rpy="0 0 0"
    mesh_file="link3.STL"/>

  <!-- Joint 3 -->
  <xacro:revolute_joint
    name="joint3"
    parent="link2" child="link3"
    origin_xyz="-0.26 0 0" origin_rpy="0 0 0"
    axis_xyz="0 -1 0"
    lower="0.0" upper="4.0"
    effort="36" velocity="5"/>

  <!-- Link 4 -->
  <xacro:arm_link
    name="link4"
    mass="0.30780516"
    ixx="0.00025787" ixy="-1.011e-05" ixz="-0.00017337"
    iyy="0.00039454" iyz="-8.09e-06" izz="0.00035094"
    origin_xyz="0.05240131 -0.00055249 0.04094177"
    origin_rpy="0 0 0"
    mesh_file="link4.STL"/>

  <!-- Joint 4 -->
  <xacro:revolute_joint
    name="joint4"
    parent="link3" child="link4"
    origin_xyz="0.23 0 0.06" origin_rpy="0 0 0"
    axis_xyz="0 -1 0"
    lower="-1.6" upper="1.6"
    effort="21" velocity="4.2"/>

  <!-- Link 5 -->
  <xacro:arm_link
    name="link5"
    mass="0.28396923"
    ixx="0.00012691" ixy="0.0" ixz="-2.4e-07"
    iyy="0.00013455" iyz="-4.9e-07" izz="0.00010788"
    origin_xyz="0.00319091 8.677e-05 -0.03641777"
    origin_rpy="0 0 0"
    mesh_file="link5.STL"/>

  <!-- Joint 5 -->
  <xacro:revolute_joint
    name="joint5"
    parent="link4" child="link5"
    origin_xyz="0.07 0 0.036319" origin_rpy="0 0 0"
    axis_xyz="0 0 -1"
    lower="-1.7" upper="1.7"
    effort="10" velocity="3.7"/>

  <!-- Link 6 -->
  <xacro:arm_link
    name="link6"
    mass="0.34073453"
    ixx="0.00025204" ixy="0.0" ixz="4.1e-07"
    iyy="0.00227113" iyz="0.0" izz="0.00247492"
    origin_xyz="0.10731798 0.0 9.64e-06"
    origin_rpy="0 0 0"
    mesh_file="link6_ttb.STL"/>

  <!-- Joint 6 -->
  <xacro:revolute_joint
    name="joint6"
    parent="link5" child="link6"
    origin_xyz="0.02345 0 -0.039" origin_rpy="0 0 0"
    axis_xyz="1 0 0"
    lower="-2.5" upper="2.5"
    effort="10" velocity="3.7"/>

  <!-- Bat Center (virtual link for end effector reference) -->
  <link name="bat_center"/>

  <joint name="bat_center_joint" type="fixed">
    <origin xyz="0.18 0 0" rpy="0 0 0"/>
    <parent link="link6"/>
    <child link="bat_center"/>
  </joint>

  <!-- Camera mount link (eye-to-hand: camera fixed in environment) -->
  <link name="camera_mount_link"/>

  <joint name="camera_mount_joint" type="fixed">
    <origin xyz="0.4 -0.25 0.35" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="camera_mount_link"/>
  </joint>

</robot>
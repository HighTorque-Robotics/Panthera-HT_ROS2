<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="panthera_ht_ros_description">

  <!-- ==================== 属性定义 ==================== -->
  <!-- 材质颜色 -->
  <xacro:property name="robot_color" value="0.752941176470588 0.752941176470588 0.752941176470588 1"/>
  <!-- 夹爪中心颜色（蓝色） -->
  <xacro:property name="gripper_center_color" value="0.866666666666667 0.909803921568627 1 1"/>

  <!-- ==================== 宏定义 ==================== -->

  <!-- 材质宏 -->
  <xacro:macro name="default_material">
    <material name="">
      <color rgba="${robot_color}"/>
    </material>
  </xacro:macro>

  <!-- 夹爪中心材质宏 -->
  <xacro:macro name="gripper_center_material">
    <material name="">
      <color rgba="${gripper_center_color}"/>
    </material>
  </xacro:macro>

  <!-- 通用 link 宏（带 mesh） -->
  <xacro:macro name="arm_link" params="name mass ixx ixy ixz iyy iyz izz origin_xyz origin_rpy mesh_file">
    <link name="${name}">
      <inertial>
        <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
        <mass value="${mass}"/>
        <inertia ixx="${ixx}" ixy="${ixy}" ixz="${ixz}"
                 iyy="${iyy}" iyz="${iyz}" izz="${izz}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://panthera_ht_ros_description/meshes/${mesh_file}"/>
        </geometry>
        <xacro:default_material/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://panthera_ht_ros_description/meshes/${mesh_file}"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <!-- 旋转关节宏 -->
  <xacro:macro name="revolute_joint" params="name parent child origin_xyz origin_rpy axis_xyz lower upper effort velocity">
    <joint name="${name}" type="revolute">
      <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
      <parent link="${parent}"/>
      <child link="${child}"/>
      <axis xyz="${axis_xyz}"/>
      <limit lower="${lower}" upper="${upper}" effort="${effort}" velocity="${velocity}"/>
    </joint>
  </xacro:macro>

  <!-- 移动关节宏（用于夹爪） -->
  <xacro:macro name="prismatic_joint" params="name parent child origin_xyz origin_rpy axis_xyz lower upper effort velocity">
    <joint name="${name}" type="prismatic">
      <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
      <parent link="${parent}"/>
      <child link="${child}"/>
      <axis xyz="${axis_xyz}"/>
      <limit lower="${lower}" upper="${upper}" effort="${effort}" velocity="${velocity}"/>
    </joint>
  </xacro:macro>

  <!-- 固定关节宏 -->
  <xacro:macro name="fixed_joint" params="name parent child origin_xyz origin_rpy">
    <joint name="${name}" type="fixed">
      <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
      <parent link="${parent}"/>
      <child link="${child}"/>
    </joint>
  </xacro:macro>

  <!-- ==================== 机器人结构定义 ==================== -->

  <!-- Base Link -->
  <xacro:arm_link
    name="base_link"
    mass="0.62922454"
    ixx="0.00061305" ixy="-1.32e-06" ixz="1.69e-06"
    iyy="0.00063876" iyz="-2.1e-07" izz="0.0007565"
    origin_xyz="5.789e-05 -0.00015938 0.02298649"
    origin_rpy="0 0 0"
    mesh_file="base_link.STL"/>

  <!-- Link 1 -->
  <xacro:arm_link
    name="link1"
    mass="0.28101551"
    ixx="0.00039386" ixy="3.75e-06" ixz="-3.733e-05"
    iyy="0.0002136" iyz="7.17e-06" izz="0.00037066"
    origin_xyz="0.00278873 -0.00094387 0.02491842"
    origin_rpy="0 0 0"
    mesh_file="link1.STL"/>

  <!-- Joint 1 -->
  <xacro:revolute_joint
    name="joint1"
    parent="base_link" child="link1"
    origin_xyz="0 0 0.0584" origin_rpy="0 0 0"
    axis_xyz="0 0 1"
    lower="-2.4" upper="2.4"
    effort="21" velocity="4.2"/>

  <!-- Link 2 -->
  <xacro:arm_link
    name="link2"
    mass="1.5165092"
    ixx="0.00044711" ixy="3.071e-05" ixz="-5.119e-05"
    iyy="0.02261049" iyz="3.01e-06" izz="0.02272105"
    origin_xyz="-0.12936212 -0.00213339 7.183e-05"
    origin_rpy="0 0 0"
    mesh_file="link2.STL"/>

  <!-- Joint 2 -->
  <xacro:revolute_joint
    name="joint2"
    parent="link1" child="link2"
    origin_xyz="0.018199 0 0.053" origin_rpy="0 0 0"
    axis_xyz="0 1 0"
    lower="0.0" upper="3.2"
    effort="36" velocity="5"/>

  <!-- Link 3 -->
  <xacro:arm_link
    name="link3"
    mass="0.66917784"
    ixx="0.00061339" ixy="-1.439e-05" ixz="-0.00070321"
    iyy="0.00538615" iyz="-1.404e-05" izz="0.00532976"
    origin_xyz="0.16343103 -0.00164646 0.05337427"
    origin_rpy="0 0 0"
    mesh_file="link3.STL"/>

  <!-- Joint 3 -->
  <xacro:revolute_joint
    name="joint3"
    parent="link2" child="link3"
    origin_xyz="-0.26 0 0" origin_rpy="0 0 0"
    axis_xyz="0 -1 0"
    lower="0.0" upper="4.0"
    effort="36" velocity="5"/>

  <!-- Link 4 -->
  <xacro:arm_link
    name="link4"
    mass="0.30780516"
    ixx="0.00025787" ixy="-1.011e-05" ixz="-0.00017337"
    iyy="0.00039454" iyz="-8.09e-06" izz="0.00035094"
    origin_xyz="0.05240131 -0.00055249 0.04094177"
    origin_rpy="0 0 0"
    mesh_file="link4.STL"/>

  <!-- Joint 4 -->
  <xacro:revolute_joint
    name="joint4"
    parent="link3" child="link4"
    origin_xyz="0.23 0 0.06" origin_rpy="0 0 0"
    axis_xyz="0 -1 0"
    lower="-1.6" upper="1.6"
    effort="21" velocity="4.2"/>

  <!-- Link 5 -->
  <xacro:arm_link
    name="link5"
    mass="0.23711139"
    ixx="4.815e-05" ixy="-3e-08" ixz="-1.5e-07"
    iyy="5.773e-05" iyz="-1e-08" izz="3.359e-05"
    origin_xyz="0.00303007 8.509e-05 -0.03624079"
    origin_rpy="0 0 0"
    mesh_file="link5.STL"/>

  <!-- Joint 5 -->
  <xacro:revolute_joint
    name="joint5"
    parent="link4" child="link5"
    origin_xyz="0.07 0 0.036319" origin_rpy="0 0 0"
    axis_xyz="0 0 -1"
    lower="-1.7" upper="1.7"
    effort="10" velocity="3.7"/>

  <!-- Link 6 -->
  <xacro:arm_link
    name="link6"
    mass="0.01"
    ixx="0.00107368" ixy="-1.25e-05" ixz="3e-07"
    iyy="0.00068998" iyz="2.517e-05" izz="0.00167551"
    origin_xyz="0.002 0.00 0.00"
    origin_rpy="0 0 0"
    mesh_file="link6.STL"/>

  <!-- Joint 6 -->
  <xacro:revolute_joint
    name="joint6"
    parent="link5" child="link6"
    origin_xyz="0.02345 0 -0.039" origin_rpy="0 0 0"
    axis_xyz="1 0 0"
    lower="-2.5" upper="2.5"
    effort="10" velocity="3.7"/>

  <!-- ==================== 夹爪部分 ==================== -->

  <!-- 左夹爪 -->
  <xacro:arm_link
    name="L_finger"
    mass="0.127457990512492"
    ixx="2.28803355388279E-05" ixy="-4.20099870625027E-06" ixz="3.42841892600802E-07"
    iyy="5.15650351948181E-05" iyz="-5.67310171718486E-10" izz="4.64985980845228E-05"
    origin_xyz="-0.0685513053302154 0.016863783322054 -0.000510235194009112"
    origin_rpy="0 0 0"
    mesh_file="L_finger.STL"/>

  <!-- 左夹爪关节 -->
  <xacro:prismatic_joint
    name="L_finger_joint"
    parent="link6" child="L_finger"
    origin_xyz="0.165 0 0" origin_rpy="0 0 0"
    axis_xyz="0 1 0"
    lower="0" upper="0.04"
    effort="100" velocity="0.5"/>

  <!-- 右夹爪 -->
  <xacro:arm_link
    name="R_finger"
    mass="0.127457990511979"
    ixx="2.28803355389148E-05" ixy="4.20099870615578E-06" ixz="-3.42841892362391E-07"
    iyy="5.15650351903219E-05" iyz="-5.67310157866966E-10" izz="4.64985980799091E-05"
    origin_xyz="-0.0685513053307259 -0.0168637833221451 0.000510464525338844"
    origin_rpy="0 0 0"
    mesh_file="R_finger.STL"/>

  <!-- 右夹爪关节（镜像左夹爪） -->
  <joint name="R_finger_joint" type="prismatic">
    <origin xyz="0.165 0 0" rpy="0 0 0"/>
    <parent link="link6"/>
    <child link="R_finger"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.04" upper="0" effort="100" velocity="0.5"/>
    <mimic joint="L_finger_joint" multiplier="-1" offset="0"/>
  </joint>

  <!-- 夹爪中心 -->
  <link name="gripper_center">
    <inertial>
      <origin xyz="-0.124818615882779 -4.88421114370448E-05 -3.8373269199643E-05" rpy="0 0 0"/>
      <mass value="0.0960375427712166"/>
      <inertia 
        ixx="9.09311609578797E-05" 
        ixy="2.21893449480774E-09" 
        ixz="-4.1053650775334E-09" 
        iyy="1.13385601698219E-05" 
        iyz="4.83664470143672E-08" 
        izz="8.46740055322188E-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://panthera_ht_ros_description/meshes/gripper_center.STL"/>
      </geometry>
      <xacro:gripper_center_material/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://panthera_ht_ros_description/meshes/gripper_center.STL"/>
      </geometry>
    </collision>
  </link>

  <!-- 夹爪中心固定关节 -->
  <xacro:fixed_joint
    name="gripper_center_joint"
    parent="link6" child="gripper_center"
    origin_xyz="0.165 0 0" origin_rpy="0 0 0"/>

</robot>